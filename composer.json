{
    "name": "codeconjure/foxpost",
    "description": "FoxPost WebAPI protokoll-kliens — keretrendszer-független, PSR-18 alapon.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "sylius-labs/coding-standard": "^4.4"
    },
    "autoload": {
        "psr-4": {
            "CodeConjure\\FoxPost\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeConjure\\FoxPost\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
